PORT=5000
JWT_SECRET=your-secret-key-change-in-production

# 前端地址（用于 OAuth 回调重定向）
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# QQ 互联 OAuth（去 https://connect.qq.com 注册应用获取）
QQ_APP_ID=
QQ_APP_KEY=

# 微信开放平台 OAuth（去 https://open.weixin.qq.com 注册应用获取）
WX_APP_ID=
WX_APP_SECRET=

# 阿里云短信服务（生产环境必填）
# 去 https://dysms.console.aliyun.com 申请
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=研词
SMS_TEMPLATE_CODE=SMS_123456789
